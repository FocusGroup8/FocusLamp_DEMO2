# ============================================================
# FocusLamp dowm - Default SDK Configuration
# ============================================================
# This file is applied on first build or after `idf.py fullclean`.
# Existing sdkconfig values take precedence over defaults.

# ------------------------------------------------------------
# HTTP Server - WebSocket support (required by websocket_manager)
# ------------------------------------------------------------
CONFIG_HTTPD_WS_SUPPORT=y

# ------------------------------------------------------------
# WebSocket Manager (mirrors project 1 / FocusLamp_DEMO2 rules)
# ------------------------------------------------------------
CONFIG_WS_MANAGER_ENABLE=y
CONFIG_WS_MANAGER_SERVER_ENABLE=y
CONFIG_WS_MANAGER_CLIENT_ENABLE=n
CONFIG_WS_MANAGER_SERVER_PORT=80
CONFIG_WS_MANAGER_SERVER_MAX_CONN=4
CONFIG_WS_MANAGER_BUFFER_SIZE=1024
CONFIG_WS_MANAGER_SERVER_ECHO=n
CONFIG_WS_MANAGER_PING_INTERVAL=10
CONFIG_WS_MANAGER_RECONNECT_TIMEOUT_MS=10000
CONFIG_WS_MANAGER_TLS_ENABLE=n

# ------------------------------------------------------------
# Connection Manager
# ------------------------------------------------------------
CONFIG_CONNECTION_MANAGER_ENABLE=y
CONFIG_CONNECTION_MANAGER_WIFI_INIT_TIMEOUT_MS=30000
CONFIG_CONNECTION_MANAGER_WIFI_RECONNECT_MAX_DELAY_MS=60000
CONFIG_CONNECTION_MANAGER_WS_RECONNECT_MAX_DELAY_MS=60000
CONFIG_CONNECTION_MANAGER_MONITOR_INTERVAL_MS=5000

# ------------------------------------------------------------
# Heartbeat Service
# ------------------------------------------------------------
CONFIG_HEARTBEAT_SERVICE_ENABLE=y
CONFIG_HEARTBEAT_SERVICE_PING_INTERVAL_SEC=30
CONFIG_HEARTBEAT_SERVICE_TIMEOUT_SEC=90

# ------------------------------------------------------------
# Message Queue (reliable delivery over WebSocket)
# ------------------------------------------------------------
CONFIG_MESSAGE_QUEUE_ENABLE=y
CONFIG_MESSAGE_QUEUE_MAX_PENDING=16
CONFIG_MESSAGE_QUEUE_MAX_RETRIES=3
