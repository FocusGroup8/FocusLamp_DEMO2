menu "Light Control Module Configuration"

    config PROJECT_ENABLE_LIGHT_CONTROL
        bool "Enable Light Control Module"
        default n
        help
            Enable or disable the light control module.
            This module provides light control functionality including manual control and automatic adjustment.

    config LIGHT_CONTROL_AUTO_MODE
        bool "Enable Automatic Light Adjustment"
        default n
        depends on PROJECT_ENABLE_LIGHT_CONTROL && PROJECT_ENABLE_LIGHT_SENSOR
        help
            Enable automatic light adjustment based on ambient light sensor.
            This feature requires the light sensor driver to be enabled.
            If disabled, only manual control is available.

    config LIGHT_CONTROL_TASK_STACK_SIZE
        int "Light Control Task Stack Size"
        default 4096
        depends on PROJECT_ENABLE_LIGHT_CONTROL && LIGHT_CONTROL_AUTO_MODE
        help
            Stack size for the light control task in bytes.

    config LIGHT_CONTROL_TASK_PRIORITY
        int "Light Control Task Priority"
        default 5
        depends on PROJECT_ENABLE_LIGHT_CONTROL && LIGHT_CONTROL_AUTO_MODE
        help
            Priority for the light control task (0-31, higher number = higher priority).

    config LIGHT_CONTROL_TASK_INTERVAL_MS
        int "Light Control Task Interval (ms)"
        default 1000
        depends on PROJECT_ENABLE_LIGHT_CONTROL && LIGHT_CONTROL_AUTO_MODE
        help
            Interval between light sensor readings in milliseconds.

    config LIGHT_CONTROL_DEFAULT_BRIGHTNESS
        int "Default LED Brightness"
        default 200
        depends on PROJECT_ENABLE_LIGHT_CONTROL
        help
            Default brightness level for the LED when turned on (0-255).

    config LIGHT_CONTROL_DEFAULT_WARM
        int "Default Warm LED Brightness"
        default 0
        depends on PROJECT_ENABLE_LIGHT_CONTROL
        help
            Default brightness for warm LED (0-8191, 13-bit PWM).

    config LIGHT_CONTROL_DEFAULT_COLD
        int "Default Cold LED Brightness"
        default 0
        depends on PROJECT_ENABLE_LIGHT_CONTROL
        help
            Default brightness for cold LED (0-8191, 13-bit PWM).

    config LIGHT_CONTROL_DEFAULT_COLOR_R
        int "Default LED Color Red"
        default 200
        depends on PROJECT_ENABLE_LIGHT_CONTROL
        help
            Default red component of LED color (0-255).

    config LIGHT_CONTROL_DEFAULT_COLOR_G
        int "Default LED Color Green"
        default 100
        depends on PROJECT_ENABLE_LIGHT_CONTROL
        help
            Default green component of LED color (0-255).

    config LIGHT_CONTROL_DEFAULT_COLOR_B
        int "Default LED Color Blue"
        default 30
        depends on PROJECT_ENABLE_LIGHT_CONTROL
        help
            Default blue component of LED color (0-255).

endmenu
