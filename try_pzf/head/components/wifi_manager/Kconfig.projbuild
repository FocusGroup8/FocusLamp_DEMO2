menu "WiFi Manager Configuration"

    config WIFI_MANAGER_ENABLE
        bool "Enable WiFi Manager"
        default y
        help
            Enable the WiFi Manager component. When disabled, all API
            functions return ERR_NOT_SUPPORTED.

    config WIFI_MANAGER_SSID
        string "WiFi SSID"
        default "myssid"
        depends on WIFI_MANAGER_ENABLE
        help
            SSID (network name) of the access point to connect to.

    config WIFI_MANAGER_PASSWORD
        string "WiFi Password"
        default "mypassword"
        depends on WIFI_MANAGER_ENABLE
        help
            WiFi password (WPA2 or WPA3) for the access point.

    config WIFI_MANAGER_MAX_RETRY
        int "Maximum retry count"
        default 5
        depends on WIFI_MANAGER_ENABLE
        help
            Maximum number of retries to connect to the AP before giving up.

    config WIFI_MANAGER_AUTO_RECONNECT
        bool "Enable auto-reconnect"
        default y
        depends on WIFI_MANAGER_ENABLE
        help
            Automatically reconnect to AP when disconnected.

    config WIFI_MANAGER_USE_STATIC_IP
        bool "Use static IP (avoid DHCP drift)"
        default n
        depends on WIFI_MANAGER_ENABLE
        help
            Use a static IP instead of DHCP. Prevents the DHCP server from
            re-assigning a different address after reconnect, which would
            break cross-board HTTP/WS links that are configured by IP.

    config WIFI_MANAGER_STATIC_IP
        string "Static IP address"
        default "10.132.136.143"
        depends on WIFI_MANAGER_USE_STATIC_IP
        help
            Fixed IP address for this board (lamp head board).

    config WIFI_MANAGER_STATIC_GATEWAY
        string "Static gateway"
        default "10.132.136.105"
        depends on WIFI_MANAGER_USE_STATIC_IP
        help
            Gateway of the RT3 hotspot network.

    config WIFI_MANAGER_STATIC_NETMASK
        string "Static netmask"
        default "255.255.255.0"
        depends on WIFI_MANAGER_USE_STATIC_IP
        help
            Subnet mask.

    config WIFI_MANAGER_STATIC_DNS
        string "Static DNS server"
        default "10.132.136.105"
        depends on WIFI_MANAGER_USE_STATIC_IP
        help
            DNS server used with the static IP. Required because the DHCP
            client is stopped, so the DHCP-provided DNS is no longer available.

endmenu
