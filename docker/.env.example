# 复制为 .env 并填写真实值
# ARK_API_KEY: 火山引擎 Ark 平台 API Key（豆包 VLM）
ARK_API_KEY=your_ark_api_key_here

# Local perception demo: one receiver + four local algorithm containers.
# Set ESP32P4_IP to the currently verified head address before startup.
ESP32P4_IP=replace_with_current_head_ip
ENABLED_ALGORITHMS=gesture_mantis,emotion,focus,phone_use
