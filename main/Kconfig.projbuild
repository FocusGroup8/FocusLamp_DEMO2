menu "Example Configuration"
    config EXAMPLE_USE_DMA2D_COPY_FRAME
        bool "Use DMA2D to copy draw buffer to frame buffer"
        default y
        help
            Enable this option, DMA2D will be used to copy the LVGL draw buffer to the target frame buffer.
            This can save some CPU time and improve the performance.

    config EXAMPLE_MONITOR_REFRESH_BY_GPIO
        bool "Monitor Refresh Rate by GPIO"
        default y
        help
            Enable this option, you can visualize the refresh rate by attaching a logic analyzer to a specific GPIO.
            The GPIO will output a square wave with the frequency equals to half of the refresh rate.

    config EXAMPLE_LCD_USE_ST7701S
        bool "Use ST7701S LCD controller"
        default y
        help
            ST7701S driver IC for KD034WXFID001 3.4 inch 480x480 MIPI DSI panel.

    config EXAMPLE_TOUCH_USE_GT911
        bool "Use GT911 touch controller"
        default y
        help
            GT911 capacitive touch controller connected via I2C.

    config EXAMPLE_ENABLE_GESTURE_RECOGNITION
        bool "Enable gesture recognition library"
        default y
        help
            Compile gesture recognition module (swipe, pinch, rotation, long press).

    config EXAMPLE_ENABLE_TOUCH_GAME
        bool "Enable touch game demo"
        default y
        help
            Compile gesture-controlled ball game demo.

    config EXAMPLE_GESTURE_DEBUG_LOG
        bool "Enable gesture recognition debug logging"
        default n
        help
            Enable verbose per-frame logging in gesture recognition.
            Disable for production to improve performance.

    choice EXAMPLE_DEMO
        prompt "Select demo to run"
        default EXAMPLE_DEMO_TOUCH_GAME
        help
            Choose which demo to run at startup. Only one demo runs at a time.

        config EXAMPLE_DEMO_TOUCH_GAME
            bool "Touch Game (gesture-controlled ball)"
            select EXAMPLE_ENABLE_TOUCH_GAME
        config EXAMPLE_DEMO_GESTURE_RECOGNITION
            bool "Gesture Recognition Demo"
            select EXAMPLE_ENABLE_GESTURE_RECOGNITION
        config EXAMPLE_DEMO_TOUCH_GUI
            bool "Touch GUI Demo (button test)"
        config EXAMPLE_DEMO_DATA_COLLECTOR
            bool "Gesture Data Collector (calibration)"
    endchoice

    config EXAMPLE_ENABLE_AUDIO
        bool "Enable audio system (I2S microphone + speaker)"
        default n
        help
            Enable I2S audio subsystem with INMP441 microphone and MAX98357A amplifier.
            This adds I2S driver, LittleFS storage, and audio codec dependencies.

    config EXAMPLE_RUN_I2S_TEST
        bool "Run I2S driver verification test on startup"
        default n
        depends on EXAMPLE_ENABLE_AUDIO
        help
            Execute I2S full-duplex test suite at startup.
            Tests channel lifecycle, TX sine wave output, RX microphone input,
            and full-duplex simultaneous operation.
            Useful for hardware verification during development.

    config EXAMPLE_AUDIO_SAMPLE_RATE
        int "Audio sample rate (Hz)"
        default 48000
        range 8000 48000
        depends on EXAMPLE_ENABLE_AUDIO
        help
            I2S audio sample rate in Hz. Common values: 8000, 16000, 22050, 44100, 48000.
            48000 is used for unified high-quality recording and playback.
            Note: 48kHz WAV recordings consume ~2.8MB per 30 seconds.

    config EXAMPLE_AUDIO_I2S_NUM
        int "I2S port number"
        default 0
        range 0 2
        depends on EXAMPLE_ENABLE_AUDIO
        help
            I2S controller port number. ESP32-P4 has I2S port 0-2.
            Use 0 for default or set to I2S_NUM_AUTO for auto-allocation.

    config EXAMPLE_AUDIO_LITTLEFS_PARTITION_LABEL
        string "LittleFS partition label"
        default "littlefs"
        depends on EXAMPLE_ENABLE_AUDIO
        help
            Label of the partition used for LittleFS audio file storage.
            Must match the partition name in partitions.csv.

    config EXAMPLE_AUDIO_MOUNT_POINT
        string "LittleFS mount point"
        default "/audio"
        depends on EXAMPLE_ENABLE_AUDIO
        help
            File system mount point for audio files.

    choice EXAMPLE_AUDIO_DEMO_MODE
        prompt "Audio demo mode"
        default EXAMPLE_AUDIO_DEMO_LOOPBACK
        depends on EXAMPLE_ENABLE_AUDIO
        help
            Select the audio demo to run.

        config EXAMPLE_AUDIO_DEMO_LOOPBACK
            bool "Loopback (mic → speaker)"
            help
                Record from microphone and immediately play through speaker.
                Tests the full I2S full-duplex path.

        config EXAMPLE_AUDIO_DEMO_RECORD_ONLY
            bool "Record only (mic → WAV file)"
            help
                Record from microphone and save as WAV file to LittleFS.

        config EXAMPLE_AUDIO_DEMO_PLAY_ONLY
            bool "Play only (Ogg file → speaker)"
            help
                Play an Ogg audio file from LittleFS through the speaker.

        config EXAMPLE_AUDIO_DEMO_FULL
            bool "Full demo (record + play + monitor)"
            help
                Complete audio system with recording, playback, and system monitoring.
    endchoice

    config EXAMPLE_ENABLE_SYSMON
        bool "Enable system resource monitor"
        default y
        depends on EXAMPLE_ENABLE_AUDIO
        help
            Enable real-time system resource monitoring during audio operations.
            Logs heap usage, task stack watermarks, and CPU utilization.

    config EXAMPLE_SYSMON_INTERVAL_SEC
        int "Monitor log interval (seconds)"
        default 10
        range 1 3600
        depends on EXAMPLE_ENABLE_SYSMON
        help
            Interval between automatic system status logs.
            Set lower value for detailed debugging, higher value for production.

    config EXAMPLE_SYSMON_PRINT_TASK_LIST
        bool "Print task list in monitor report"
        default y
        depends on EXAMPLE_ENABLE_SYSMON
        help
            Include FreeRTOS task list with stack high water marks.
            Increases log output but useful for debugging.
endmenu
