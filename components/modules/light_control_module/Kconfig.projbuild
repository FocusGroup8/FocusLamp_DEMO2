menu "Light Control Module Configuration"

    config PROJECT_ENABLE_LIGHT_CONTROL
        bool "Enable Light Control Module"
        default n
        help
            Enable or disable the light control module.
            This module provides manual light control via the UART light
            controller. Automatic light adjustment based on the ambient light
            sensor was removed together with the light sensor module.

    config LIGHT_CONTROL_DEFAULT_BRIGHTNESS
        int "Default LED Brightness"
        default 200
        depends on PROJECT_ENABLE_LIGHT_CONTROL
        help
            Default brightness level for the LED when turned on (0-255).

    config LIGHT_CONTROL_DEFAULT_WARM
        int "Default Warm LED Brightness"
        default 0
        depends on PROJECT_ENABLE_LIGHT_CONTROL
        help
            Default brightness for warm LED (0-8191, 13-bit PWM).

    config LIGHT_CONTROL_DEFAULT_COLD
        int "Default Cold LED Brightness"
        default 0
        depends on PROJECT_ENABLE_LIGHT_CONTROL
        help
            Default brightness for cold LED (0-8191, 13-bit PWM).

    config LIGHT_CONTROL_DEFAULT_COLOR_R
        int "Default LED Color Red"
        default 200
        depends on PROJECT_ENABLE_LIGHT_CONTROL
        help
            Default red component of LED color (0-255).

    config LIGHT_CONTROL_DEFAULT_COLOR_G
        int "Default LED Color Green"
        default 100
        depends on PROJECT_ENABLE_LIGHT_CONTROL
        help
            Default green component of LED color (0-255).

    config LIGHT_CONTROL_DEFAULT_COLOR_B
        int "Default LED Color Blue"
        default 30
        depends on PROJECT_ENABLE_LIGHT_CONTROL
        help
            Default blue component of LED color (0-255).

endmenu
